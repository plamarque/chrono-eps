# frozen_string_literal: true
opt_out_usage  # Désactive les analytics pour éviter les prompts en CI

default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci(force: true)  # Keychain CI — évite blocage Embed Pods Frameworks
    cocoapods(use_bundle_exec: true)

    # Récupère certificat et provisioning profile (Match)
    match(
      type: "appstore",
      readonly: true,
      app_identifier: "io.github.plamarque"
    )

    increment_build_number(xcodeproj: "Chrono EPS.xcodeproj")

    build_app(
      workspace: "Chrono EPS.xcworkspace",
      scheme: "Chrono EPS",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "ChronoEPS.ipa",
      # Forcer le profil Match — Apple Distribution (pas iOS Development) pour l'archive App Store
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=\"Apple Distribution\" PROVISIONING_PROFILE_SPECIFIER=\"match AppStore io.github.plamarque\"",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "io.github.plamarque" => "match AppStore io.github.plamarque"
        }
      }
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      ipa: "./build/ChronoEPS.ipa",
      app_store_connect_api_key: app_store_connect_api_key(
        key_id: ENV["APPSTORE_KEY_ID"],
        issuer_id: ENV["APPSTORE_ISSUER_ID"],
        key_content: ENV["APPSTORE_API_PRIVATE_KEY"]
      )
    )
  end

  desc "Submit build from TestFlight to App Store review"
  lane :promote do |options|
    tag = options[:tag] || ENV["PROMOTE_TAG"]
    raise "Tag requis. Utiliser: fastlane promote tag:v0.1.2 ou PROMOTE_TAG=v0.1.2" if tag.to_s.empty?
    app_version = tag.to_s.sub(/^v/, "")

    deliver(
      app_identifier: "io.github.plamarque",
      submit_for_review: true,
      skip_metadata: true,
      skip_screenshots: true,
      app_version: app_version,
      app_store_connect_api_key: app_store_connect_api_key(
        key_id: ENV["APPSTORE_KEY_ID"],
        issuer_id: ENV["APPSTORE_ISSUER_ID"],
        key_content: ENV["APPSTORE_API_PRIVATE_KEY"]
      )
    )
  end
end
